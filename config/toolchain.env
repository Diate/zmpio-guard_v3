# ZMPIO Guard V3 - external toolchain and host locations
#
# This is the ONLY file in the tree that may contain an absolute path.
# Everything inside the repository is addressed relatively, derived from the
# calling script's own location.
#
# Format: KEY=VALUE, one per line, no quotes, no spaces around '='.
# Read by scripts/project_paths.{py,sh,bat}, scripts/ProjectPaths.psm1 and
# hardware/rtl/bd/project_paths.tcl.
#
# An environment variable that is already set always wins over the value
# below, so CI and one-off overrides need no edit here.

# --- Xilinx tools (Windows host) -------------------------------------------
VITIS_ROOT=E:/Xilinx/Vitis/2023.2
VIVADO_ROOT=E:/Xilinx/Vivado/2023.2

# --- Cross compiler for the PetaLinux user space ---------------------------
ARM_LINUX_CC=E:/Xilinx/Vitis/2023.2/gnu/aarch32/nt/gcc-arm-linux-gnueabi/bin/arm-linux-gnueabihf-gcc.exe

# --- Staging share between the Windows host and the PetaLinux build VM -----
WINDOWS_SHARE_DIR=E:/share

# --- PetaLinux project on the build VM -------------------------------------
PETALINUX_PROJECT_DIR=/home/petalinux/zynq_openamp

# --- Target board ----------------------------------------------------------
TARGET_HOST=root@192.168.1.50
